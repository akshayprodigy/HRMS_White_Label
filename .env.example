# MariaDB
MARIADB_SERVER=db
MARIADB_USER=erp_user
MARIADB_PASSWORD=erp_password
MARIADB_DB=erp_db
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=root_password

# Backend
PROJECT_NAME="Veliora"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Optional: externally visible origin for absolute links (ICS feed URL) behind a proxy
# PUBLIC_BASE_URL=https://hr.example.com

# ---- Emergency broadcast SMS (India DLT) --------------------------------
# GO-LIVE REQUIREMENT: with MSG91 every SMS template must be DLT-registered.
# Register the emergency templates ("EMERGENCY: {#var#} - {#var#}" and
# "NEEDS HELP: {#var#} - {#var#}") and put the DLT template ids here, or
# emergency SMS deliveries fail with "DLT template id not configured".
# EMERGENCY_BROADCAST_DLT_TEMPLATE_ID=
# EMERGENCY_NEED_HELP_DLT_TEMPLATE_ID=
